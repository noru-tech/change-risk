{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noru.tech/spec/ai-change-provenance/change-risk/v0.1/population.schema.json",
  "title": "change-risk emergency population",
  "description": "Every merged change carrying the emergency label in a window: who declared it, whether they were allowed to, and when its retroactive review is due.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "generated",
    "repository",
    "label",
    "window",
    "complete",
    "changes"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "kind": {
      "const": "change-risk-emergency-population"
    },
    "generated": {
      "$ref": "#/$defs/generated"
    },
    "repository": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "since",
        "until"
      ],
      "properties": {
        "since": {
          "$ref": "#/$defs/time"
        },
        "until": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "complete": {
      "type": "boolean"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "change",
          "url",
          "merged_at",
          "declared_by",
          "declared_at",
          "allowed",
          "review_within_days",
          "review_due"
        ],
        "properties": {
          "change": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "merged_at": {
            "$ref": "#/$defs/time"
          },
          "declared_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "declared_at": {
            "oneOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          },
          "allowed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "review_within_days": {
            "type": [
              "integer",
              "null"
            ]
          },
          "review_due": {
            "oneOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]*$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "level": {
      "enum": [
        "low",
        "standard",
        "high"
      ]
    },
    "change_type": {
      "enum": [
        "standard",
        "normal",
        "emergency"
      ]
    },
    "tier": {
      "enum": [
        "low",
        "standard",
        "high",
        "emergency"
      ]
    },
    "pattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^!\\s\\[\\]\\\\][^\\s\\[\\]\\\\]*$"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_human_approvals": {
          "type": "integer",
          "minimum": 0
        },
        "agent_review": {
          "enum": [
            "allowed",
            "forbidden"
          ]
        },
        "required_reviewer_teams": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "uniqueItems": true
        },
        "required_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "retroactive_review_within_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "version"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

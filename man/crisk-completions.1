.TH crisk-completions 1  "completions 0.1.0" 
.SH NAME
crisk\-completions \- Generate shell completions
.SH SYNOPSIS
\fBcrisk completions\fR [\fB\-q\fR|\fB\-\-quiet\fR] [\fB\-h\fR|\fB\-\-help\fR] [\fB\-V\fR|\fB\-\-version\fR] <\fISHELL\fR> 
.SH DESCRIPTION
Generate shell completions
.SH OPTIONS
.TP
\fB\-q\fR, \fB\-\-quiet\fR
Suppress status lines on stderr
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
.TP
\fB\-V\fR, \fB\-\-version\fR
Print version
.TP
<\fISHELL\fR>

.br
